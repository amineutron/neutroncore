# Copier en .env.local (gitignore) et adapter.
# Hote du serveur media (Plex, *arr, qBittorrent...) affiche dans l'ecran Outils.
VITE_MEDIA_HOST=192.0.2.10
# URL du backend lyra-control-api chargee par la coque Android (via Tailscale).
NEUTRONCORE_URL=http://100.64.0.1:9876/app/
# Hotes autorises en cleartext par l'APK (IP Tailscale du PC, tailnet, IP LAN media).
NEUTRONCORE_TAILSCALE_IP=100.64.0.1
NEUTRONCORE_TAILNET=example.tail0000.ts.net
