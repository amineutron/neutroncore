{
  "name": "neutroncore",
  "version": "0.1.0",
  "description": "neutroncore: self-hosted homelab hub PWA and Android shell driven by Lyra",
  "license": "MIT",
  "author": "amineutron",
  "repository": {
    "type": "git",
    "url": "https://github.com/amineutron/neutroncore.git"
  },
  "homepage": "https://github.com/amineutron/neutroncore",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:demo": "VITE_MOCK_API=1 VITE_BASE=/neutroncore/ VITE_MEDIA_HOST=media-server.lan tsc -b && VITE_MOCK_API=1 VITE_BASE=/neutroncore/ VITE_MEDIA_HOST=media-server.lan vite build --outDir dist-demo --emptyOutDir",
    "check:demo": "node scripts/check-demo-bundle.mjs dist-demo"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "satellite.js": "5.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
