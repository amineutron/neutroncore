{
  "name": "neutroncore",
  "version": "0.1.0",
  "description": "neutroncore: self-hosted homelab hub PWA and Android shell driven by Lyra",
  "license": "MIT",
  "author": "amineutron",
  "repository": {
    "type": "git",
    "url": "https://github.com/amineutron/neutroncore.git"
  },
  "homepage": "https://github.com/amineutron/neutroncore",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:demo": "VITE_MOCK_API=1 VITE_BASE=/neutroncore/ VITE_MEDIA_HOST=media-server.lan tsc -b && VITE_MOCK_API=1 VITE_BASE=/neutroncore/ VITE_MEDIA_HOST=media-server.lan vite build --outDir dist-demo --emptyOutDir",
    "check:demo": "node scripts/check-demo-bundle.mjs dist-demo",
    "e2e:vms": "node scripts/e2e/vms.e2e.mjs",
    "bench:vms": "vitest run src/lib/vmHubBench.test.ts"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satellite.js": "7.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.5.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.1.0",
    "world-atlas": "2.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
